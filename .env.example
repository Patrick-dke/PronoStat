# =====================================================================
#  PronoStat — copiez ce fichier en « .env » puis remplissez les clés.
#  Toutes les clés sont OPTIONNELLES : sans elles l'app fonctionne encore,
#  mais avec moins de données (et un niveau de confiance plus bas).
# =====================================================================

# --- ANCRAGE DU MARCHÉ (le plus important) ---------------------------
# Inscription gratuite (~500 requêtes/mois) : https://the-odds-api.com/
# Indispensable pour le tennis (les tournois n'existent que là).
ODDS_API_KEY=

# --- FOOTBALL --------------------------------------------------------
# API-Football via RapidAPI (~100 req/jour) — la plus riche :
# xG, corners, cartons, tirs, possession, classements, confrontations.
# https://rapidapi.com/api-sports/api/api-football
RAPIDAPI_KEY=
# Gratuit, grandes ligues (classements + résultats) :
# https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# --- BASKET (NBA) ----------------------------------------------------
# Gratuit : https://www.balldontlie.io/
BALLDONTLIE_API_KEY=

# --- REPLI UNIVERSEL -------------------------------------------------
# TheSportsDB : « 3 » est la clé de test publique gratuite.
# Limites connues du palier gratuit : ~10 équipes par ligue et 1 seul
# match d'historique par équipe. https://www.thesportsdb.com/api.php
THESPORTSDB_API_KEY=3

# =====================================================================
#  COUVERTURE DES COMPÉTITIONS
#  Le registre complet vit dans config.py (SUPPORTED_COMPETITIONS).
#  Ces interrupteurs activent les compétitions secondaires.
# =====================================================================
# Coupes nationales (FA Cup, Copa del Rey, DFB-Pokal, Coppa Italia,
# Coupe de France) : données gratuites nettement moins fiables.
COMPETITIONS_INCLUDE_NATIONAL_CUPS=false
COMPETITIONS_INCLUDE_SUMMER_LEAGUE=false
COMPETITIONS_INCLUDE_G_LEAGUE=false

# =====================================================================
#  Activation / désactivation des sources (prêt pour le payant)
# =====================================================================
SOURCE_THE_ODDS_API=true
SOURCE_FOOTBALL_DATA=true
SOURCE_API_FOOTBALL=true
SOURCE_THESPORTSDB=true
SOURCE_BALLDONTLIE=true
SOURCE_NHL_API=true
# Sources publiques ouvertes (aucune clé) : ce sont elles qui fournissent
# les effectifs complets des championnats.
SOURCE_OPENFOOTBALL=true
SOURCE_WIKIPEDIA=true
SOURCE_WIKIDATA=true
SOURCE_NEWS_RSS=true
SOURCE_WEATHER=true

# Identité déclarée aux API publiques (MediaWiki et Wikidata l'exigent).
# Mettez un contact valide avant toute mise en ligne publique.
PRONOSTAT_USER_AGENT=PronoStat/3.0 (contact: votre.email@exemple.com)

# Mode premium : réservé pour brancher plus tard des sources payantes.
# Élargit aussi la fenêtre de statistiques détaillées (10 matchs au lieu de 6).
PRONOSTAT_PREMIUM=false

# =====================================================================
#  Quotas déclarés (utilisés tant que l'API ne renvoie pas ses en-têtes)
# =====================================================================
QUOTA_ODDS_MONTH=500
QUOTA_API_FOOTBALL_DAY=100
QUOTA_FOOTBALL_DATA_DAY=100
QUOTA_BALLDONTLIE_DAY=300
# Seuil d'alerte (0.80 = prévenir à 80 % de consommation)
QUOTA_WARN_RATIO=0.80

# =====================================================================
#  Paramètres du moteur — modifiables sans toucher au code
# =====================================================================
# Mélange marché / modèle : 0.60 = 60 % marché, 40 % modèle
MARKET_WEIGHT=0.60
# Nombre de simulations Monte Carlo (plancher imposé : 10 000)
MC_SIMS=20000
# Seuil de détection d'une opportunité (0.05 = +5 points de probabilité)
VALUE_THRESHOLD=0.05
# Fourchette du pronostic principal : en dessous c'est trop incertain,
# au-dessus c'est quasi certain donc sans intérêt.
PICK_MIN_PROBABILITY=0.45
PICK_MAX_PROBABILITY=0.80
PICK_WINNER_BONUS=0.10
# Avantage du terrain
HOME_ADV_FOOTBALL=1.12
HOME_ADV_HOCKEY=1.06
HOME_ADV_BASKET=2.4
# Paramètre Dixon-Coles (corrige 0-0, 1-0, 0-1, 1-1)
DIXON_COLES_RHO=-0.08
# Nombre de matchs récents analysés par équipe
FORM_WINDOW=10

# --- signaux enrichis (chacun neutralisable avec 0) -------------------
# Part des expected goals face aux buts réels (0 = ignorer les xG)
XG_WEIGHT=0.50
# Poids maximal des confrontations directes
H2H_WEIGHT=0.15
# Valeur d'un match de la saison complète face à un match récent
STANDINGS_WEIGHT=0.20
# Pénalité maximale de fatigue (0.04 = −4 % sur un back-to-back)
REST_PENALTY_MAX=0.04
REST_REFERENCE_DAYS=3.0

# =====================================================================
#  AGENT D'ANALYSE — raisonnement multicritère
#  Ces poids sont les leviers d'amélioration au fil du temps. Les
#  statistiques de calibration (onglet « Mes analyses précédentes »)
#  proposent des ajustements ; rien n'est appliqué sans votre accord.
# =====================================================================
# Facteurs déjà pris en compte par la simulation (rôle explicatif)
WEIGHT_FORME_RECENTE=1.00
WEIGHT_CONFRONTATIONS=0.45
WEIGHT_DOMICILE_EXTERIEUR=0.70
WEIGHT_EFFICACITE_OFFENSIVE=0.85
WEIGHT_SOLIDITE_DEFENSIVE=0.85
WEIGHT_CLASSEMENT=0.60
WEIGHT_RECUPERATION=0.35
WEIGHT_CONSENSUS_MARCHE=1.20
# Facteurs qui ajustent réellement la décision
WEIGHT_DYNAMIQUE=0.40
WEIGHT_CALENDRIER=0.30
WEIGHT_IMPORTANCE=0.25
WEIGHT_EVOLUTION_COTES=0.55

# Amplitude maximale de l'ajustement issu de ces derniers facteurs.
AGENT_TILT_STRENGTH=0.08
# Réduction maximale de confiance due aux contradictions détectées.
AGENT_CONTRADICTION_PENALTY=2.5
# Lots indépendants servant à mesurer la stabilité des probabilités.
AGENT_STABILITY_BATCHES=5
# Analyse reproductible : la graine dérive des données, pas de l'horloge.
AGENT_DETERMINISTIC=true
# Nombre de facteurs clés et de risques affichés.
AGENT_TOP_FACTORS=4
AGENT_TOP_RISKS=3

# =====================================================================
#  Environnement d'exécution
# =====================================================================
# development | production
PRONOSTAT_ENV=development
# WARNING en production, INFO en développement.
PRONOSTAT_LOG_LEVEL=INFO

# Mode diagnostic : ajoute un panneau détaillant les sources interrogées, les
# données écartées et les valeurs du modèle. Réservé au développement — il
# reste désactivé de force quand PRONOSTAT_ENV=production.
PRONOSTAT_DEBUG=false

# Régions de bookmakers essayées dans l'ordre, en repli l'une de l'autre.
# Élargir améliore les chances de trouver des cotes, au prix d'un crédit
# supplémentaire par région réellement interrogée.
ODDS_REGIONS=eu,uk,us

# =====================================================================
#  Cache (organisé par compétition)
# =====================================================================
TTL_ROSTER=604800      # effectifs : 7 jours (ils changent une fois par saison)
TTL_ODDS=1200
TTL_FORM=43200
TTL_STANDINGS=43200
TTL_CATALOG=43200
HTTP_TIMEOUT=12
# Le service public Wikidata est plus lent qu'une API REST.
SPARQL_TIMEOUT=25
# Nombre d'appels réseau menés en parallèle par la collecte.
MAX_PARALLEL_FETCHES=8
