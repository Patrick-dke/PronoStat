# =====================================================================
#  Secrets pour un déploiement en ligne (Streamlit Community Cloud).
#
#  NE COMMITEZ JAMAIS le fichier « secrets.toml » réel — il est exclu
#  par .gitignore. En ligne, collez ce contenu dans :
#      votre application → Settings → Secrets
#
#  En local, préférez le fichier « .env » : les deux fonctionnent, et
#  l'environnement l'emporte sur les secrets.
# =====================================================================

# --- Clés API (toutes optionnelles) ---
ODDS_API_KEY = ""
RAPIDAPI_KEY = ""
FOOTBALL_DATA_API_KEY = ""
BALLDONTLIE_API_KEY = ""
THESPORTSDB_API_KEY = "3"

# --- Réglages courants ---
ODDS_REGIONS = "eu"
MARKET_WEIGHT = "0.60"
MC_SIMS = "20000"

# Identité déclarée aux API publiques (MediaWiki et Wikidata l'exigent).
# Remplacez par un contact valide avant toute mise en ligne publique.
PRONOSTAT_USER_AGENT = "PronoStat/3.0 (contact: votre.email@exemple.com)"

# Sur un hébergement au disque éphémère, le cache va dans un dossier
# temporaire ; laissez vide pour le comportement par défaut.
# PRONOSTAT_CACHE_DIR = "/tmp/pronostat-cache"
