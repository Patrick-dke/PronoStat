{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pronostat",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "streamlit", "run", "app.py", "--server.port", "8501", "--server.headless", "true", "--server.address", "0.0.0.0"],
      "port": 8501
    },
    {
      "name": "hosting-preview",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "http.server", "8502", "--directory", "public"],
      "port": 8502
    },
    {
      "name": "web",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"],
      "port": 8000
    }
  ]
}
